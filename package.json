{
  "name": "pi-chalin",
  "version": "1.0.0",
  "description": "Pi Coding Agent extension for routed, memory-aware subagent workflows",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xkuze/pi-chalin.git"
  },
  "bugs": {
    "url": "https://github.com/0xkuze/pi-chalin/issues"
  },
  "homepage": "https://github.com/0xkuze/pi-chalin#readme",
  "packageManager": "pnpm@11.5.1",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./agents/*": "./src/agents/*.ts",
    "./artifacts/*": "./src/artifacts/*.ts",
    "./budget/*": "./src/budget/*.ts",
    "./commands/*": "./src/commands/*.ts",
    "./config/*": "./src/config/*.ts",
    "./domain/*": "./src/domain/*.ts",
    "./interview/*": "./src/interview/*.ts",
    "./kernel/*": "./src/kernel/*.ts",
    "./memory/*": "./src/memory/*.ts",
    "./observability/*": "./src/observability/*.ts",
    "./orchestration/*": "./src/orchestration/*.ts",
    "./project/*": "./src/project/*.ts",
    "./routing/*": "./src/routing/*.ts",
    "./runner/*": "./src/runner/*.ts",
    "./runtime/*": "./src/runtime/*.ts",
    "./skills/*": "./src/skills/*.ts",
    "./tools/*": "./src/tools/*.ts",
    "./ui/*": "./src/ui/*.ts",
    "./webfetch/*": "./src/webfetch/*.ts",
    "./worktrees/*": "./src/worktrees/*.ts",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src/**/*.ts",
    "agents/**/*.md",
    "skills/**/SKILL.md",
    "assets/**/*.png",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:stable": "tsc --noEmit --stableTypeOrdering"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "subagents",
    "agentic",
    "memory",
    "orchestration"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "effect": "3.21.2",
    "sql.js-fts5": "1.4.0",
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.78.0",
    "@earendil-works/pi-tui": "0.78.0",
    "@types/node": "25.9.1",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=26.3.0",
    "pnpm": ">=11.5.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.3.0",
      "onFail": "download"
    }
  }
}
